SHARES: ADMBaseX

EXTENDS KEYWORD initial_data
{
  "GRTresnaIDX" :: "Read spacetime initial data from GRTresna output"
}

EXTENDS KEYWORD initial_lapse
{
  "GRTresnaIDX" :: "Read lapse from GRTresna output"
}

EXTENDS KEYWORD initial_shift
{
  "GRTresnaIDX" :: "Read shift from GRTresna output"
}

PRIVATE:

STRING grtresna_filename "Path to GRTresna output HDF5 file"
{
  ".*" :: "Any filename, potentially with path"
} ""

KEYWORD grtresna_format "Input format"
{
  "auto"          :: "Autodetect from metadata and datasets"
  "grtresna_hdf5" :: "GRTresna HDF5 output format"
} "auto"

KEYWORD interpolation "Sampling method from source cells to CarpetX vertices"
{
  "nearest"   :: "Nearest-neighbor sampling"
  "trilinear" :: "Trilinear interpolation"
} "nearest"

KEYWORD adm_population_method "How to populate ADMBaseX vertex-centered fields"
{
  "direct"            :: "Sample source data directly at ADMBaseX vertices"
  "cell-centered-c2v" :: "Sample source data at CarpetX cell centers, convert to ADM there, then interpolate cell-centered ADM fields to vertices"
} "cell-centered-c2v"

INT c2v_order "Cell-centered to vertex-centered interpolation order for adm_population_method=cell-centered-c2v"
{
  2 :: "Second-order eight-cell average"
  4 :: "Fourth-order symmetrized cell-centered to vertex-centered interpolation"
} 2

KEYWORD out_of_bounds "Behavior when a CarpetX point is outside the source domain"
{
  "clamp"      :: "Clamp to nearest valid source cell"
  "error"      :: "Abort run with an actionable error message"
  "asymptotic" :: "Use a boundary-matched asymptotically flat exterior"
} "clamp"

KEYWORD lapse_profile "How to initialize lapse when ADMBaseX::initial_lapse is GRTresnaIDX"
{
  "file"            :: "Use the lapse stored in the source file"
  "determinant-psi" :: "Use alpha=det(g)^(-1/12), a puncture-style pre-collapsed lapse estimate"
} "file"

BOOLEAN sanity_checks "Print rank-0 min/max sanity checks after setup"
{
} "yes"

BOOLEAN set_source_regrid_error "Populate CarpetXRegrid::regrid_error from the source HDF5 AMR boxes"
{
} "no"

INT extra_coarse_levels "Number of CarpetX levels coarser than source level 0 when mapping source AMR boxes"
{
  0:* :: "0 means CarpetX level 0 matches source level 0"
} 0

INT source_level_offset "Additional source AMR level offset added after extra_coarse_levels mapping"
{
  *:* :: "0 preserves CarpetX level to source level mapping; positive values use finer source levels"
} 0

BOOLEAN use_source_center "Use source_center[] instead of auto-centering from source index extents"
{
} "no"

CCTK_REAL source_center[3] "Coordinates subtracted in source mapping x=(i+0.5)*dx-center"
{
  (*:*) :: "Any real values"
} 0.0

CCTK_REAL chi_floor "Lower bound for chi when converting BSSN-like fields to ADM"
{
  (0:*) :: "Strictly positive"
} 1.0e-14

INT verbosity "Verbosity level"
{
  0:* :: "0=silent, 1=summary, 2=debug"
} 1
